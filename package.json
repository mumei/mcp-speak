{
  "name": "mcp-speak",
  "version": "1.1.0",
  "description": "Local macOS text-to-speech MCP server using the built-in say command",
  "type": "module",
  "main": "index.js",
  "bin": {
    "mcp-speak": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "node test.js",
    "worker": "node src/worker.js",
    "queue:status": "node src/queue-cli.js status",
    "queue:stop": "node src/queue-cli.js stop",
    "queue:shutdown": "node src/queue-cli.js shutdown",
    "queue:mute": "node src/queue-cli.js mute",
    "queue:unmute": "node src/queue-cli.js unmute",
    "test:queue:smoke": "node scripts/queue-smoke.js"
  },
  "keywords": [
    "mcp",
    "text-to-speech",
    "say",
    "tts"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumei/mcp-speak.git"
  },
  "homepage": "https://github.com/mumei/mcp-speak#readme",
  "bugs": {
    "url": "https://github.com/mumei/mcp-speak/issues"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE"
  ]
}
